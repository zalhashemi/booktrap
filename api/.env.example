# BookTrap API service. Copy to api/.env for local development.
# Every key here is server-side only. None of them ever goes in the web app.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Supabase: Project Settings -> API Keys. Use the SECRET key (sb_secret_...) or the
# legacy service_role key, never the publishable/anon key.
# Leave both empty in development to use in-memory storage (wiped on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2+: TikTok and Instagram scraping (one Apify token), extraction, enrichment.
APIFY_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Which Claude model reads posts, and how hard it thinks (low | medium | high | xhigh | max).
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_EFFORT=medium
# Also add books only seen in the background (e.g. a shelf behind the creator).
INCLUDE_BACKGROUND_BOOKS=false

# Key for hashing client IPs for the per-network cap (raw IPs are never stored). Any long random
# string, e.g. `openssl rand -base64 32`. Required in production; development falls back to a fixed key.
IP_HASH_KEY=

# Comma-separated list of web origins allowed to call the API (strict CORS).
ALLOWED_ORIGIN=http://localhost:5180

# Reverse proxies in front of the API whose X-Forwarded-For is trusted for client IPs.
# Defaults to 1 in production (Render's edge), 0 locally. Never set it higher than reality.
TRUST_PROXY_HOPS=
REGISTRATIONS_PER_IP_PER_HOUR=60

# Cost controls.
DAILY_LINK_CAP_PER_DEVICE=40
DAILY_LINK_CAP_PER_IP=120
MAX_LINKS_PER_SUBMISSION=30
MAX_VIDEOS_PER_COLLECTION=100
MONTHLY_BUDGET_USD=20
GLOBAL_SPEND_KILL_SWITCH=false

# Data retention (see the privacy policy). Cached posts are deleted after this many days; hashed
# networks are cleared from jobs after 2 days, once the daily caps no longer need them.
POST_CACHE_DAYS=90
