# Public URL of the BookTrap API service. Not a secret: it ships in the bundle.
VITE_API_URL=http://localhost:8787

# Supabase, for sign-in only. Both are public and ship in the bundle. Use the **publishable** key
# (Project Settings, API Keys: sb_publishable_...), never a secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key (public). Set it once CAPTCHA protection is on in Supabase (Authentication,
# Attack Protection), or every sign-in fails. Leave it empty while CAPTCHA is off.
VITE_TURNSTILE_SITE_KEY=
